><mxGeometry relative="1" as="geometry"><mxPoint x="1645" y="865" as="sourcePoint"/><mxPoint x="1670" y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f64_26" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="983" as="sourcePoint"/><mxPoint x="605" y="983" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f64_27" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="983" as="sourcePoint"/><mxPoint x="960" y="983" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f64_28" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="983" as="sourcePoint"/><mxPoint x="1315" y="983" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Cómo se hizo el diccionario revisado"><mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1900" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=10;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="62" width="28" height="22" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0C9;strokeColor=#C98A1B;strokeWidth=3;fontSize=10;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="62" width="28" height="22" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8A8A8A;strokeWidth=3;fontSize=10;verticalAlign=top;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="630" y="62" width="28" height="22" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;1. Fuentes&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Wikcionario (es), Wiktionary (en, vía kaikki.org) y Román (1901–1918)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;3.403 términos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=17;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="420" height="190" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;2. Frecuencia en tuits&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Cuántos tuits de la muestra contienen cada término y sus formas escritas&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Se ordena de más a menos frecuente&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=17;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="130" width="420" height="190" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;3. Cinco libros&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Excel con hojas verbos, ados, especies y otros&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Verbo y verbo-se en una sola fila&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=17;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="950" y="130" width="420" height="190" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;4. Revisión del libro 1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Flo decide sí / no por término&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Claude propone definiciones; Flo aprueba, edita o rechaza&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;433 sí, 220 no&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=17;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1410" y="130" width="420" height="190" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;5. Reemplazos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Claude propone la palabra neutra por sentido&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Flo valida&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Se marca «ambiguo» si la palabra también es estándar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=17;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="440" width="420" height="190" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;6. diccionario_flo_parte1.csv&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Una fila por término: definición, reemplazo, ambiguo, variantes&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Lo lee baselines.py&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=17;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="440" width="420" height="190" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;7. Libros 2 a 5&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;Se revisan solo si la comparación muestra que vale la pena&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;(retorno decreciente: son los términos menos frecuentes)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8A8A8A;strokeWidth=3;fontSize=17;verticalAlign=top;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="950" y="440" width="420" height="190" as="geometry"/></mxCell><mxCell id="t2" value="Cómo se llegó al diccionario revisado (lo que hizo Flo, con Claude)" style="text;html=1;whiteSpace=wrap;fontSize=28;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1800" height="40" as="geometry"/></mxCell><mxCell id="t4" value="hecho y ejecutado" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="66" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t6" value="escrito, sin ejecutar" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="366" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t8" value="pendiente" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="666" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t16" value="Criterio de unificación: se une el verbo con su forma en -se y las variantes escritas. No se unen participios ni derivados de otra clase." style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="1800" height="36" as="geometry"/></mxCell><mxCell id="f16_0" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="225" as="sourcePoint"/><mxPoint x="490" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f16_1" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="225" as="sourcePoint"/><mxPoint x="950" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f16_2" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1370" y="225" as="sourcePoint"/><mxPoint x="1410" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f16_3" style="html=1;endArrow=block;endFill=1;strokeWidth=3;stroke