<mxfile host="app.diagrams.net"><diagram id="p1" name="Los sistemas en paralelo"><mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="2040" pageHeight="1453"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=10;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="62" width="28" height="22" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0C9;strokeColor=#C98A1B;strokeWidth=3;fontSize=10;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="62" width="28" height="22" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8A8A8A;strokeWidth=3;fontSize=10;verticalAlign=top;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="630" y="62" width="28" height="22" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Sin diccionario&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9AA5B1;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="250" y="175" width="330" height="84" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;3 conjuntos de pares&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;lote1 (213), noticias (72), tuits (165)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="175" width="330" height="84" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Identidad&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;copia la oración tal cual (piso de comparación)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1315" y="175" width="330" height="84" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;identidad&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;BLEU 85,7 · 94,0 · 82,7&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;chrF 88,9 · 95,2 · 85,8&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBD9D9;strokeColor=#B85450;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="175" width="330" height="84" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Diccionario automático&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Wikcionario es + en, sin revisión humana&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="283" width="330" height="84" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Reemplazo = 1ª frase de la definición&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;automático; varios quedan mal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="605" y="283" width="330" height="84" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;3 conjuntos de pares&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;los mismos 450 pares&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="283" width="330" height="84" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Reglas&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;sustituye cada término por su reemplazo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1315" y="283" width="330" height="84" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;reglas_equipo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;BLEU 84,1 · 91,2 · 81,3&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;chrF 87,9 · 93,7 · 85,6&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBD9D9;strokeColor=#B85450;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="283" width="330" height="84" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;El mismo diccionario automático&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="391" width="330" height="84" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Igual que arriba&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;el automático no marca ambiguos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="605" y="391" width="330" height="84" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;3 conjuntos de pares&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="391" width="330" height="84" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Reglas + ambiguos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;--incluir-ambiguos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1315" y="391" width="330" height="84" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;reglas_equipo_con_ambiguos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;BLEU 84,1 · 91,2 · 81,3&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;chrF 87,9 · 93,7 · 85,6&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBD9D9;strokeColor=#B85450;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="391" width="330" height="84" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Diccionario revisado a mano&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;libro 1: 433 términos, definiciones corregidas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="499" width="330" height="84" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Reemplazo validado por Flo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;1 por sentido; se usa el primero; marca «ambiguo»&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="605" y="499" width="330" height="84" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;3 conjuntos de pares&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="499" width="330" height="84" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Reglas, sin ambiguos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;no sustituye lo que también es palabra estándar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1315" y="499" width="330" height="84" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;reglas_flo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;BLEU 89,6 · 94,8 · 86,1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;chrF 92,1 · 96,3 · 89,3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBD9D9;strokeColor=#B85450;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="499" width="330" height="84" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;El mismo diccionario revisado&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="607" width="330" height="84" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Igual que arriba&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="605" y="607" width="330" height="84" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;3 conjuntos de pares&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="607" width="330" height="84" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Reglas + ambiguos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;--incluir-ambiguos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1315" y="607" width="330" height="84" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;reglas_flo_con_ambiguos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;BLEU 88,5 · 90,6 · 83,5&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;chrF 91,2 · 94,4 · 88,9&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBD9D9;strokeColor=#B85450;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="607" width="330" height="84" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Sin diccionario&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9AA5B1;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="250" y="715" width="330" height="84" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;3 conjuntos de pares&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="715" width="330" height="84" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;LLM zero-shot&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;solo la oración; modelo de Claude Code&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1315" y="715" width="330" height="84" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;llm_zero_shot&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;BLEU 90,1 · 94,2 · 83,2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;chrF 92,9 · 96,0 · 86,8&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBD9D9;strokeColor=#B85450;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="715" width="330" height="84" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;El mismo diccionario revisado&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="823" width="330" height="84" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Definición y todas las alternativas&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;se le pasan al LLM como contexto&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="605" y="823" width="330" height="84" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;3 conjuntos de pares&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="823" width="330" height="84" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;LLM con diccionario&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;elige el reemplazo según el contexto&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1315" y="823" width="330" height="84" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;llm_dicc_flo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;BLEU 91,1 · 95,7 · 89,4&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;chrF 93,6 · 97,3 · 92,6&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBD9D9;strokeColor=#7A1F1F;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="823" width="330" height="84" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;Diccionario revisado&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;solo para armar los pares de entrenamiento&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="931" width="330" height="84" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;1.500 pares propios&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;borrador del LLM sin revisar; texto limpio&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="605" y="931" width="330" height="84" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;3 conjuntos de pares&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;solo de prueba, nunca de entrenamiento&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="931" width="330" height="84" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;mT5-small ajustado&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;8 épocas en la GPU de Flo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1315" y="931" width="330" height="84" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;mt5_flo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;BLEU 81,0 · 91,6 · 80,4&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;chrF 87,1 · 94,1 · 84,6&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBD9D9;strokeColor=#B85450;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="931" width="330" height="84" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;Sin diccionario&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9AA5B1;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="250" y="1039" width="330" height="84" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;3 conjuntos de pares&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="1039" width="330" height="84" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Opus-MT (Helsinki-NLP)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;español → inglés → español, en la GPU&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1315" y="1039" width="330" height="84" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;mt_ida_vuelta&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;BLEU 44,5 · 50,0 · 33,9&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;chrF 65,1 · 68,8 · 54,6&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBD9D9;strokeColor=#B85450;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="1039" width="330" height="84" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;Sin diccionario&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9AA5B1;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="250" y="1147" width="330" height="84" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b&gt;3 conjuntos de pares&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="1147" width="330" height="84" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;NLLB-200 (Meta)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;español → inglés → español, en la GPU&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1315" y="1147" width="330" height="84" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;nllb_ida_vuelta&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;BLEU 38,5 · 34,5 · 25,2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;chrF 60,5 · 55,4 · 47,7&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBD9D9;strokeColor=#B85450;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="1147" width="330" height="84" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;Diccionario revisado&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;va como contexto del borrador&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="1265" width="330" height="84" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;oraciones.py → borrador.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;oraciones del corpus + versión neutra del LLM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="605" y="1265" width="330" height="84" as="geometry"/></mxCell><mxCell id="c78" value="&lt;b&gt;Pares propios&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;1.500 de entrenamiento (sin revisar) y 3 de prueba (revisados)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="1265" width="330" height="84" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b&gt;mT5 + Mixture of Experts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;mT5 hecho; la variante con MoE aún no existe&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8A8A8A;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1315" y="1265" width="330" height="84" as="geometry"/></mxCell><mxCell id="t2" value="Los 8 sistemas y 2 traductores de referencia, una línea cada uno" style="text;html=1;whiteSpace=wrap;fontSize=28;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1900" height="40" as="geometry"/></mxCell><mxCell id="t4" value="hecho y ejecutado" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="66" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t6" value="escrito, sin ejecutar" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="366" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t8" value="pendiente" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="666" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t9" value="1. Diccionario" style="text;html=1;whiteSpace=wrap;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="330" height="28" as="geometry"/></mxCell><mxCell id="t10" value="A automático · B, C revisado" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="330" height="24" as="geometry"/></mxCell><mxCell id="t11" value="2. De dónde sale el reemplazo" style="text;html=1;whiteSpace=wrap;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="605" y="100" width="330" height="28" as="geometry"/></mxCell><mxCell id="t12" value="solo cambia entre A y B" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="605" y="130" width="330" height="24" as="geometry"/></mxCell><mxCell id="t13" value="3. Pares" style="text;html=1;whiteSpace=wrap;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="330" height="28" as="geometry"/></mxCell><mxCell id="t14" value="los 10 usan los 3 conjuntos" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="130" width="330" height="24" as="geometry"/></mxCell><mxCell id="t15" value="4. Quién traduce" style="text;html=1;whiteSpace=wrap;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="1315" y="100" width="330" height="28" as="geometry"/></mxCell><mxCell id="t16" value="reglas o LLM" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1315" y="130" width="330" height="24" as="geometry"/></mxCell><mxCell id="t17" value="5. Resultado" style="text;html=1;whiteSpace=wrap;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="1670" y="100" width="330" height="28" as="geometry"/></mxCell><mxCell id="t18" value="lote1 · noticias · tuits" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1670" y="130" width="330" height="24" as="geometry"/></mxCell><mxCell id="t19" value="identidad&lt;br&gt;no cambia nada" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="225" height="84" as="geometry"/></mxCell><mxCell id="t24" value="reglas_equipo&lt;br&gt;A: dicc. automático" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="283" width="225" height="84" as="geometry"/></mxCell><mxCell id="t30" value="reglas_equipo_con_ambiguos&lt;br&gt;A + términos ambiguos" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="391" width="225" height="84" as="geometry"/></mxCell><mxCell id="t36" value="reglas_flo&lt;br&gt;B: dicc. revisado" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="499" width="225" height="84" as="geometry"/></mxCell><mxCell id="t42" value="reglas_flo_con_ambiguos&lt;br&gt;B + términos ambiguos" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="607" width="225" height="84" as="geometry"/></mxCell><mxCell id="t48" value="llm_zero_shot&lt;br&gt;C: LLM sin diccionario" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="225" height="84" as="geometry"/></mxCell><mxCell id="t53" value="llm_dicc_flo&lt;br&gt;C: LLM + dicc. revisado" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="823" width="225" height="84" as="geometry"/></mxCell><mxCell id="t59" value="mt5_flo&lt;br&gt;C: mT5 ajustado con pares propios" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="931" width="225" height="84" as="geometry"/></mxCell><mxCell id="t65" value="mt_ida_vuelta&lt;br&gt;referencia: Opus-MT es-en-es" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="1039" width="225" height="84" as="geometry"/></mxCell><mxCell id="t70" value="nllb_ida_vuelta&lt;br&gt;referencia: NLLB es-en-es" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="1147" width="225" height="84" as="geometry"/></mxCell><mxCell id="t75" value="Plan de datos&lt;br&gt;(idea de Flo)" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="1265" width="225" height="84" as="geometry"/></mxCell><mxCell id="t80" value="Parecido: los 10 usan los mismos tres conjuntos de pares y terminan en el mismo archivo de resultados. Las reglas (A y B) solo cambian en el diccionario y en incluir o no los ambiguos. Diferente: el LLM no usa reglas y recibe el diccionario como contexto; mt5_flo aprende de pares propios. La variante con Mixture of Experts falta." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="1374" width="1950" height="60" as="geometry"/></mxCell><mxCell id="f80_0" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="217" as="sourcePoint"/><mxPoint x="960" y="217" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f80_1" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="217" as="sourcePoint"/><mxPoint x="1315" y="217" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f80_2" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1645" y="217" as="sourcePoint"/><mxPoint x="1670" y="217" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f80_3" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="325" as="sourcePoint"/><mxPoint x="605" y="325" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f80_4" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="325" as="sourcePoint"/><mxPoint x="960" y="325" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f80_5" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="325" as="sourcePoint"/><mxPoint x="1315" y="325" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f80_6" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1645" y="325" as="sourcePoint"/><mxPoint x="1670" y="325" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f80_7" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="433" as="sourcePoint"/><mxPoint x="605" y="433" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f80_8" style="html=1;endArrow=block;endFill=1;strokeWidth=3;st