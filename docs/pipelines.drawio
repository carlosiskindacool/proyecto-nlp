s="geometry"/></mxCell><mxCell id="t10" value="A automático · B, C revisado" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="330" height="24" as="geometry"/></mxCell><mxCell id="t11" value="2. De dónde sale el reemplazo" style="text;html=1;whiteSpace=wrap;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="605" y="100" width="330" height="28" as="geometry"/></mxCell><mxCell id="t12" value="solo cambia entre A y B" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="605" y="130" width="330" height="24" as="geometry"/></mxCell><mxCell id="t13" value="3. Pares" style="text;html=1;whiteSpace=wrap;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="330" height="28" as="geometry"/></mxCell><mxCell id="t14" value="los 7 usan lote1.csv" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="130" width="330" height="24" as="geometry"/></mxCell><mxCell id="t15" value="4. Quién traduce" style="text;html=1;whiteSpace=wrap;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="1315" y="100" width="330" height="28" as="geometry"/></mxCell><mxCell id="t16" value="reglas o LLM" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1315" y="130" width="330" height="24" as="geometry"/></mxCell><mxCell id="t17" value="5. Resultado" style="text;html=1;whiteSpace=wrap;fontSize=17;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="1670" y="100" width="330" height="28" as="geometry"/></mxCell><mxCell id="t18" value="BLEU y chrF, 213 pares" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1670" y="130" width="330" height="24" as="geometry"/></mxCell><mxCell id="t19" value="identidad&lt;br&gt;no cambia nada" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="225" height="84" as="geometry"/></mxCell><mxCell id="t24" value="reglas_equipo&lt;br&gt;A: dicc. automático" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="283" width="225" height="84" as="geometry"/></mxCell><mxCell id="t30" value="reglas_equipo_con_ambiguos&lt;br&gt;A + términos ambiguos" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="391" width="225" height="84" as="geometry"/></mxCell><mxCell id="t36" value="reglas_flo&lt;br&gt;B: dicc. revisado" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="499" width="225" height="84" as="geometry"/></mxCell><mxCell id="t42" value="reglas_flo_con_ambiguos&lt;br&gt;B + términos ambiguos" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="607" width="225" height="84" as="geometry"/></mxCell><mxCell id="t48" value="llm_zero_shot&lt;br&gt;C: LLM sin diccionario" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="225" height="84" as="geometry"/></mxCell><mxCell id="t53" value="llm_dicc_flo&lt;br&gt;C: LLM + dicc. revisado" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="823" width="225" height="84" as="geometry"/></mxCell><mxCell id="t59" value="Plan de datos&lt;br&gt;(idea de Flo, sin ejecutar)" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="941" width="225" height="84" as="geometry"/></mxCell><mxCell id="t64" value="Parecido: los 7 usan los mismos 213 pares y terminan en el mismo archivo de resultados. Las reglas (A y B) solo cambian en el diccionario y en incluir o no los ambiguos. Diferente: el LLM no usa reglas y recibe el diccionario como contexto. El plan de datos aún no es un sistema evaluado." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="1050" width="1950" height="60" as="geometry"/></mxCell><mxCell id="f64_0" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="217" as="sourcePoint"/><mxPoint x="960" y="217" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f64_1" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="217" as="sourcePoint"/><mxPoint x="1315" y="217" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f64_2" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1645" y="217" as="sourcePoint"/><mxPoint x="1670" y="217" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f64_3" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeome