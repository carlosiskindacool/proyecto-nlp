er;spacing=6;" vertex="1" parent="1"><mxGeometry x="2200" y="1183" width="300" height="90" as="geometry"/></mxCell><mxCell id="c92" value="&lt;b&gt;Corpus (parquet)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;chilean-spanish-corpus, 63 archivos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9AA5B1;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="250" y="1305" width="300" height="90" as="geometry"/></mxCell><mxCell id="c93" value="&lt;b&gt;oraciones.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;candidatas_entrenamiento.csv: 3.382 oraciones&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="575" y="1305" width="300" height="90" as="geometry"/></mxCell><mxCell id="c94" value="&lt;b&gt;borrador.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;el LLM propone la versión neutra (se usan 1.500)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="1305" width="300" height="90" as="geometry"/></mxCell><mxCell id="c95" value="&lt;b&gt;Revisión humana&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;solo los 3 conjuntos de prueba; el entrenamiento no se revisa&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6DDF3;strokeColor=#7A5FA8;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1225" y="1305" width="300" height="90" as="geometry"/></mxCell><mxCell id="c96" value="&lt;b&gt;entrenar_mt5.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;ajusta mT5-small con los pares (sin menciones ni emojis)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#5E9A5B;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1550" y="1305" width="300" height="90" as="geometry"/></mxCell><mxCell id="c97" value="&lt;b&gt;models/mt5_flo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;modelo ajustado (no se sube a git)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E6F5;strokeColor=#3E7AB0;strokeWidth=3;fontSize=14;verticalAlign=top;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1875" y="1305" width="300" height="90" as="geometry"/></mxCell><mxCell id="c98" value="&lt;b&gt;mT5 + Mixture of Experts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;mT5 hecho (fila mt5_flo); la variante con MoE aún no existe&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8A8A8A;strokeWidth=3;fontSize=15;verticalAlign=top;align=center;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="2200" y="1305" width="300" height="90" as="geometry"/></mxCell><mxCell id="t2" value="Los 8 sistemas y 2 traductores, una línea cada uno: qué archivos entran y qué sale de cada paso" style="text;html=1;whiteSpace=wrap;fontSize=28;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="2300" height="40" as="geometry"/></mxCell><mxCell id="t4" value="archivo" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="66" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t6" value="script, ya ejecutado" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="366" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t8" value="script, sin ejecutar" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="666" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t10" value="paso manual" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="966" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t12" value="no hay paso / externo" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1266" y="60" width="255" height="26" as="geometry"/></mxCell><mxCell id="t13" value="1. Fuente" style="text;html=1;whiteSpace=wrap;fontSize=16;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="300" height="28" as="geometry"/></mxCell><mxCell id="t14" value="A: Wiktionary · B y C: revisión propia" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="300" height="24" as="geometry"/></mxCell><mxCell id="t15" value="2. Arma el diccionario" style="text;html=1;whiteSpace=wrap;fontSize=16;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="575" y="100" width="300" height="28" as="geometry"/></mxCell><mxCell id="t16" value="A automático · B y C manual" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="575" y="130" width="300" height="24" as="geometry"/></mxCell><mxCell id="t17" value="3. Diccionario" style="text;html=1;whiteSpace=wrap;fontSize=16;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="300" height="28" as="geometry"/></mxCell><mxCell id="t18" value="el mismo archivo se reutiliza" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="300" height="24" as="geometry"/></mxCell><mxCell id="t19" value="4. Pares" style="text;html=1;whiteSpace=wrap;fontSize=16;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="1225" y="100" width="300" height="28" as="geometry"/></mxCell><mxCell id="t20" value="los 10 usan los 3 conjuntos" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1225" y="130" width="300" height="24" as="geometry"/></mxCell><mxCell id="t21" value="5. Quién traduce" style="text;html=1;whiteSpace=wrap;fontSize=16;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="1550" y="100" width="300" height="28" as="geometry"/></mxCell><mxCell id="t22" value="reglas o LLM" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1550" y="130" width="300" height="24" as="geometry"/></mxCell><mxCell id="t23" value="6. Predicciones" style="text;html=1;whiteSpace=wrap;fontSize=16;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="1875" y="100" width="300" height="28" as="geometry"/></mxCell><mxCell id="t24" value="un archivo por script" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1875" y="130" width="300" height="24" as="geometry"/></mxCell><mxCell id="t25" value="7. Resultado" style="text;html=1;whiteSpace=wrap;fontSize=16;align=center;verticalAlign=middle;fontStyle=1;fillColor=#E8EAED;rounded=1;" vertex="1" parent="1"><mxGeometry x="2200" y="100" width="300" height="28" as="geometry"/></mxCell><mxCell id="t26" value="BLEU y chrF por conjunto" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="130" width="300" height="24" as="geometry"/></mxCell><mxCell id="t27" value="identidad&lt;br&gt;no cambia nada" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="225" height="90" as="geometry"/></mxCell><mxCell id="t33" value="reglas_equipo&lt;br&gt;A: dicc. automático" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="287" width="225" height="90" as="geometry"/></mxCell><mxCell id="t41" value="reglas_equipo_con_ambiguos&lt;br&gt;A + términos ambiguos" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="399" width="225" height="90" as="geometry"/></mxCell><mxCell id="t47" value="reglas_flo&lt;br&gt;B: dicc. revisado" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="511" width="225" height="90" as="geometry"/></mxCell><mxCell id="t55" value="reglas_flo_con_ambiguos&lt;br&gt;B + términos ambiguos" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="623" width="225" height="90" as="geometry"/></mxCell><mxCell id="t61" value="llm_zero_shot&lt;br&gt;C: LLM sin diccionario" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="735" width="225" height="90" as="geometry"/></mxCell><mxCell id="t67" value="llm_dicc_flo&lt;br&gt;C: LLM + dicc. revisado" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="847" width="225" height="90" as="geometry"/></mxCell><mxCell id="t73" value="mt5_flo&lt;br&gt;C: mT5 ajustado con pares propios" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="959" width="225" height="90" as="geometry"/></mxCell><mxCell id="t79" value="mt_ida_vuelta&lt;br&gt;referencia: Opus-MT es-en-es" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="1071" width="225" height="90" as="geometry"/></mxCell><mxCell id="t85" value="nllb_ida_vuelta&lt;br&gt;referencia: NLLB es-en-es" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="1183" width="225" height="90" as="geometry"/></mxCell><mxCell id="t91" value="Plan de datos&lt;br&gt;(idea de Flo)" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;fillColor=#F4F4F4;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="1305" width="225" height="90" as="geometry"/></mxCell><mxCell id="t99" value="Parecido: los 10 usan los mismos tres conjuntos de pares y terminan en el mismo archivo de resultados. Las reglas cambian solo en el diccionario y en incluir o no los ambiguos. Diferente: el LLM no usa reglas; mt5_flo se entrena con los pares propios del plan de datos (la variante con Mixture of Experts falta)." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="1420" width="2400" height="60" as="geometry"/></mxCell><mxCell id="f99_0" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="220" as="sourcePoint"/><mxPoint x="1225" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f99_1" style="html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#37474F;rounded=0;" edge="1" parent="1"><mxGeo